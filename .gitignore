# 若有大量草稿式 notebook 不想跟踪，可在下面自行列举：
# scratch_*.ipynb
# playground_*.ipynb


# ================= 深度学习相关 =====================
# ----- 模型权重 / checkpoint -----
*.pt
*.pth
*.pth.tar
*.ckpt
*.safetensors
*.bin
*.gguf
*.onnx
*.engine           # TensorRT engine
*.plan             # TensorRT plan
*.param[s]         # MXNet params
*.mar              # TorchServe archive
weights/
ckpts/
ckpts.*/
checkpoints/
checkpoint-*/
pretrained/
backbone_weights/
saved_models/
wandb/run-*/files/   # 兜底(wandb 目录已在下文整目录忽略)

# ----- 训练状态 / optimizer states / LR scheduler dumps ---
optimizers/
opt_states/
scheduler_states/
epoch_state.pt       # 已被上面 *.pt 覆盖，列此仅为提示


# ======== 遥感数据集与大数组中间产物(GB级)=========
# 注意：下列任意一项都极易超出 GitHub 单文件大小限制，
# 必须排除。如有必要提交极小的示例切片(<10MB)，请新建独立
# sample_assets/ 目录并在其内放置后再于末尾加 `!` 反向规则。
data/
datasets/
dataset/
raw_data/
raw_images/
raw_tiles/
processed_data/
intermediate/
features_cache/
patches/
samples_subset/
images/
imgs/
gt/
labels_y/
pred_masks/

