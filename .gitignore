*.py[cod]
*$py.class
*.so
build/
dist/
wheels/
*.egg
*.egg-info/
.eggs/
sdist/
develop-eggs/
installed.cfg


# ---------------- 虚拟环境 -------------------------
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/
conda_env/
.python-version


# ---- 包管理 lock 文件策略说明 ----
# 默认不强制忽略任何 lock 文件以便复现；以下注释行可按团队约定打开：
# Pipfile.lock
# poetry.lock
# uv.lock
# pdm.lock


